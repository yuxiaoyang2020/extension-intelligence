# 复制成 .env（不要提交进git），按你本机实际情况修改
DJANGO_SECRET_KEY=dev-secret-key-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# 用 Navicat 建好 chrome_ext_intel 这个空数据库即可，直接用你本机已有的 root 账号连接
DB_NAME=chrome_ext_intel
DB_USER=root
DB_PASSWORD=123456
DB_HOST=127.0.0.1
DB_PORT=3306

# 指向你本机现有代码里 scripts/ 目录的绝对路径（snapshot_store.py 等所在位置）
LEGACY_SCRIPTS_DIR=/Users/dhh/Desktop/code/chrome_extension_data/scripts

# generate_customer_dataset 命令生成的CSV存放目录。不填的话默认是
# LEGACY_SCRIPTS_DIR 上一级的 customer_dataset/ 目录（跟 scripts/、parquet/ 同级）。
CUSTOMER_DATASET_DIR=

# Google 登录——去 Google Cloud Console 申请（OAuth客户端ID，应用类型选"Web应用"，
# 重新导向URI填 http://localhost:8000/accounts/google/login/callback/）
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Stripe——去 Stripe Dashboard 申请，先用测试模式的 sk_test_/pk_test_ 开头的key。
# PRICE 是"Professional"/"Custom Intelligence"两个产品分别建好的 Price ID
# （格式 price_xxx，不是 Product ID）。WEBHOOK_SECRET 见下面 stripe listen 那条命令的输出。
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_CUSTOM=